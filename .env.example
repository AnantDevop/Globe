# Application environment: development | test | production
APP_ENV=development

# Which MarketDataProvider implementation the API routes use.
#   mock      - deterministic fixture data, clearly labeled MOCK. Never used
#               in production (the app fails safe if selected there).
#   indstocks - INDstocks/INDmoney adapter. Requires the credentials below.
MARKET_DATA_PROVIDER=mock

# INDstocks/INDmoney credentials (server-side only — never sent to the
# browser). Required when MARKET_DATA_PROVIDER=indstocks.
INDSTOCKS_API_KEY=
INDSTOCKS_ACCESS_TOKEN=

# Public app name, safe to expose to the browser.
NEXT_PUBLIC_APP_NAME=Global Market Globe
